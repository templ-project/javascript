{
  "name": "@templ-project/javascript-template",
  "version": "1.0.0",
  "description": "A JavaScript Bootstrap/Template project using modern tools and best practices",
  "type": "module",
  "main": "./src/index.js",
  "exports": {
    ".": {
      "import": "./src/index.js",
      "require": "./dist/index.cjs"
    }
  },
  "scripts": {
    "start": "node src/index.js",
    "build": "rollup -c",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "lint": "eslint --fix .",
    "lint:check": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "type-check": "jshint src/",
    "validate": "run-s format lint type-check duplicate-check test",
    "prepare": "husky install",
    "license-check": "license-checker --onlyAllow 'MIT;ISC;Apache-2.0;BSD-2-Clause;BSD-3-Clause;BlueOak-1.0.0;BSD*;Python-2.0;CC-BY-4.0;CC-BY-3.0;CC0-1.0;WTFPL OR MIT;MIT AND CC-BY-3.0'",
    "duplicate-check": "jscpd src/",
    "clean": "rimraf dist coverage .nyc_output"
  },
  "keywords": ["javascript", "template", "bootstrap", "node", "esm", "vitest", "eslint", "prettier"],
  "author": "Templ Project",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/templ-project/javascript.git"
  },
  "bugs": {
    "url": "https://github.com/templ-project/javascript/issues"
  },
  "homepage": "https://github.com/templ-project/javascript#readme",
  "engines": {
    "node": ">=18.0.0",
    "npm": ">=8.0.0"
  },
  "prettier": "@templ-project/prettier",
  "devDependencies": {
    "@templ-project/eslint": "^1.0.4",
    "@templ-project/prettier": "^1.0.3",
    "@templ-project/vitest": "^0.1.3",
    "@vitest/coverage-v8": "^2.0.0",
    "husky": "^9.0.0",
    "jscpd": "^4.0.0",
    "jshint": "^2.13.0",
    "license-checker": "^25.0.0",
    "lint-staged": "^15.0.0",
    "npm-run-all2": "^8.0.4",
    "rimraf": "^6.0.0",
    "rollup": "^4.0.0",
    "vitest": "^2.0.0"
  },
  "lint-staged": {
    "*.{js,mjs,cjs}": ["eslint --fix", "prettier --write"],
    "*.{json,md,yml,yaml}": ["prettier --write"]
  }
}
